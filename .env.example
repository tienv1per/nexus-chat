APP_ENV=local
LOG_LEVEL=debug

CHAT_HTTP_PORT=8080
WS_HTTP_PORT=8081
CHAT_GRPC_PORT=9080
WS_GRPC_PORT=9081

POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=chat_v1

# Local PostgreSQL fallback. For Neon, replace this with the pooled or direct
# connection string from the Neon console. Keep quotes because Neon strings
# usually contain '&channel_binding=require'.
POSTGRES_DSN=postgres://chat:chat@localhost:5432/chat_v1?sslmode=disable
# POSTGRES_DSN="postgresql://role:password@ep-example-pooler.region.aws.neon.tech/chat_v1?sslmode=require&channel_binding=require"

REDIS_ADDR=localhost:6379
REDIS_URL=redis://localhost:6379/0

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_MESSAGE_CREATED=chat.message.created
KAFKA_TOPIC_MESSAGE_DELIVERED=chat.message.delivered
KAFKA_RETENTION_MS=86400000

UPLOAD_DIR=./data/uploads
MEDIA_MAX_BYTES=26214400

SESSION_TTL_SECONDS=60
PRESENCE_TTL_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=25

JWT_SECRET=local-dev-secret-change-me
